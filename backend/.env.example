# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env.
#   cp .env.example .env
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Comma-separated list of allowed browser origins. Must NOT be "*" when
# credentials are enabled, or the refresh cookie will be rejected.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string. Create the database first:
#   CREATE DATABASE biras;
DATABASE_URL="postgresql://USER:Bira@123@localhost:5432/biras?schema=public"

# ---------------------------------------------------------------------------
# Auth — generate strong random values, e.g. `openssl rand -base64 48`
# These MUST be different from each other.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# bcrypt cost. 12 is a good production value; drop to 10 in tests for speed.
BCRYPT_ROUNDS=12

# Set to false only for local development over plain HTTP. Browsers reject
# Secure cookies over http://, which breaks refresh in local dev.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# CORS — extra origins beyond FRONTEND_URL (comma separated), optional
# ---------------------------------------------------------------------------
CORS_EXTRA_ORIGINS=

# ---------------------------------------------------------------------------
# Email provider: console | smtp
# `console` prints the email to the terminal, which is how password-reset links
# are obtained in development. Switch to `smtp` and fill in the block below.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM="Bira's Collections <no-reply@birascollections.com>"

# SMTP_* required only when EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Bira's Collections <no-reply@birascollections.com>"

# ---------------------------------------------------------------------------
# Payment provider: dev | telebirr | cbe | chapa
# `dev` fakes authorisation without moving money, for local development.
# No provider is configured by default, so no real money can be taken.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=dev

# TELEBIRR_* required only when PAYMENT_PROVIDER=telebirr
# TELEBIRR_APP_ID=
# TELEBIRR_APP_SECRET=
# TELEBIRR_BASE_URL=https://api.telebirr.com

# CBE_* required only when PAYMENT_PROVIDER=cbe
# CBE_APP_ID=
# CBE_APP_SECRET=
# CBE_BASE_URL=https://api.cbe.com.et

# CHAPA_* required only when PAYMENT_PROVIDER=chapa
# CHAPA_SECRET_KEY=

# ---------------------------------------------------------------------------
# Image storage: url | s3
# Products are seeded with public URLs, so no upload storage is required out of
# the box. Add credentials here when you enable uploads.
# ---------------------------------------------------------------------------
IMAGE_STORAGE=url

# S3_* required only when IMAGE_STORAGE=s3
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Seed credentials. Development only — override before running the seed
# anywhere that matters. See prisma/seed.ts for the failure guard.
# ---------------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=superadmin@biras.demo
SEED_SUPER_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@biras.demo
SEED_ADMIN_PASSWORD=
SEED_MANAGER_EMAIL=manager@biras.demo
SEED_MANAGER_PASSWORD=
SEED_STAFF_EMAIL=staff@biras.demo
SEED_STAFF_PASSWORD=
SEED_CUSTOMER_EMAIL=customer@biras.demo
SEED_CUSTOMER_PASSWORD=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10